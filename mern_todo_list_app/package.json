{
  "name": "clearlist",
  "version": "2.0.0",
  "description": "Secure full-stack task application with authentication and user-isolated data.",
  "main": "server.js",
  "scripts": {
    "test": "node --test --test-force-exit test/*.test.js",
    "client-install": "npm install --prefix client",
    "start": "node server.js",
    "server": "node server.js",
    "client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "npm run build --prefix client"
  },
  "author": "David Miller",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "concurrently": "^10.0.4",
    "dotenv": "^17.2.2",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.3",
    "morgan": "^1.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
